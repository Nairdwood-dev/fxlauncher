<Window x:Class="Nairdwood.Launcher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="380" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" Cursor="Hand"
        MouseLeftButtonUp="SplashWindow_MouseLeftButtonUp">
    <Border CornerRadius="18" BorderBrush="#245A8D" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="7" Opacity="0.65" />
        </Border.Effect>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1C1C1C" Offset="0" />
                <GradientStop Color="#2E2E2E" Offset="0.58" />
                <GradientStop Color="#1B3044" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Border Width="4" Height="280" HorizontalAlignment="Left" Margin="1,0,0,0"
                    Background="#3E7CB1" CornerRadius="0,2,2,0" Opacity="0.9" />

            <Button Content="✕" Width="38" Height="34" Margin="0,12,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                    Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                    FontSize="17" Padding="0" ToolTip="Continue to Nairdwood Launcher"
                    Click="CloseButton_Click" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Assets/nairdwood-text.png" Width="430" Height="100" Stretch="Uniform" />
                <TextBlock Text="FXSERVER LAUNCHER" HorizontalAlignment="Center" Margin="0,18,0,0"
                           FontSize="14" Foreground="#7DA9CB" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Text="Click anywhere to continue" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,18" Foreground="#AFAFAF"
                       FontSize="12" />
        </Grid>
    </Border>
</Window>
