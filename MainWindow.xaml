<Window x:Class="Nairdwood.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nairdwood Launcher" Width="1380" Height="860" MinWidth="1040" MinHeight="680"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,17" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#24384A" Offset="0" />
                    <GradientStop Color="#2E2E2E" Offset="0.48" />
                    <GradientStop Color="#1F2F3D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="330" Height="77" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="Assets/nairdwood-text.png" Width="330" Height="77"
                           Stretch="Uniform" HorizontalAlignment="Left" />
                    <TextBlock Text="FXServer control and live console" FontSize="10"
                               FontWeight="Bold" FontStyle="Italic"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="135,0,0,3" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="13,8" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#777777" Margin="0,0,7,0" />
                                <TextBlock x:Name="StatusText" Text="OFFLINE" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="RuntimeText" Text="00:00:00" FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="PidText" Text="PID —" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}"
                            Click="SettingsButton_Click" ToolTip="Show or hide launcher settings" Margin="0,0,10,0"
                            Foreground="{StaticResource SecondaryAccentBrush}" />
                    <Button x:Name="MariaDbButton" Content="Checking MariaDB..." Click="MariaDbButton_Click"
                            ToolTip="Start or stop the MariaDB Windows service" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}" Height="38" VerticalAlignment="Center" />
                    <Button x:Name="StartButton" Content="▶" Style="{StaticResource IconButton}"
                            Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                            Click="StartButton_Click" ToolTip="Start server" Margin="0,0,8,0" />
                    <Button x:Name="RestartButton" Content="↻" Style="{StaticResource IconButton}"
                            Click="RestartButton_Click" ToolTip="Restart server" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="StopButton" Content="■" Style="{StaticResource IconButton}"
                            Click="StopButton_Click" ToolTip="Gracefully stop server" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="KillButton" Content="✕" Click="KillButton_Click" IsEnabled="False"
                            Style="{StaticResource IconButton}" Background="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            ToolTip="Immediately terminate the complete server process tree" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="18,10,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Button Content="Find next" DockPanel.Dock="Right" Click="FindNextButton_Click" Margin="7,0,0,0" />
                <TextBox x:Name="SearchBox" ToolTip="Search console output" KeyDown="SearchBox_KeyDown" />
            </DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SearchResultText" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,15,0" />
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" IsChecked="True"
                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button Content="Clear" Click="ClearButton_Click" Margin="14,0,0,0" />
                <Button Content="Export log" Click="ExportLogButton_Click" Margin="7,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="18,0,18,10" Background="#111111" BorderBrush="#484848"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <RichTextBox x:Name="ConsoleOutput" Background="#111111" Foreground="#DADFE8"
                         BorderThickness="0" IsReadOnly="True" IsUndoEnabled="False"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="14" AcceptsTab="True">
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                        <MenuItem Header="Select all" Click="SelectAllConsole_Click" />
                        <Separator />
                        <MenuItem Header="Clear console" Click="ClearButton_Click" />
                    </ContextMenu>
                </RichTextBox.ContextMenu>
                <FlowDocument PagePadding="0" />
            </RichTextBox>
        </Border>

        <Grid Grid.Row="4" Margin="18,0,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="CommandBox" FontFamily="Cascadia Mono, Consolas"
                         ToolTip="Enter an FXServer console command" KeyDown="CommandBox_KeyDown" />
                <TextBlock x:Name="CommandUnavailableText" Text="Set up RCON password to send commands"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" />
            </Grid>
            <Button Grid.Column="1" x:Name="SendCommandButton" Content="Send Command" Style="{StaticResource AccentButton}"
                    Click="SendCommandButton_Click" Margin="8,0,0,0" />
        </Grid>

        <Border Grid.Row="5" Background="#191919" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="Select FXServer.exe or a launch script to begin."
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="NAIRDWOOD" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource SecondaryAccentBrush}" />
            </Grid>
        </Border>

        <Grid x:Name="SettingsPanel" Grid.RowSpan="6" Panel.ZIndex="102" Background="#B8000000"
              Visibility="Collapsed">
            <Border Width="900" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource SecondaryAccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="26">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="LAUNCHER SETTINGS" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Launch target, server configuration and remote command access"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="LAUNCH EXECUTABLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,0,5" />
                                    <DockPanel>
                                        <Button Content="Browse" DockPanel.Dock="Right" Click="BrowseButton_Click" Margin="7,0,0,0" />
                                        <TextBox x:Name="ExecutablePathBox" ToolTip="FXServer.exe or a .bat/.cmd launcher" />
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ARGUMENTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,0,5" />
                                    <TextBox x:Name="ArgumentsBox" ToolTip="Leave empty for txAdmin monitor mode" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="WORKING DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,15,0,5" />
                            <TextBox x:Name="WorkingDirectoryBox" />

                            <TextBlock Text="SERVER CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,15,0,5" />
                            <DockPanel>
                                <Button Content="Read RCON" DockPanel.Dock="Right" Click="ReadRconButton_Click" Margin="7,0,0,0" />
                                <Button Content="Browse" DockPanel.Dock="Right" Click="ConfigBrowseButton_Click" Margin="7,0,0,0" />
                                <TextBox x:Name="ConfigPathBox" ToolTip="Usually server.cfg" />
                            </DockPanel>

                            <Border Margin="0,15,0,0" Padding="14" Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RCON HOST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,8,5" />
                                    <TextBlock Grid.Column="1" Text="PORT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,8,5" />
                                    <TextBlock Grid.Column="2" Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,8,5" />
                                    <TextBox Grid.Row="1" x:Name="RconHostBox" Padding="8,5" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RconPortBox" Padding="8,5" Margin="0,0,8,0" />
                                    <PasswordBox Grid.Row="1" Grid.Column="2" x:Name="RconPasswordBox" Padding="8,5"
                                                 PasswordChanged="RconPasswordBox_PasswordChanged" Background="#242424"
                                                 Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Write to config" Click="WriteRconButton_Click" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <CheckBox x:Name="AutoRestartCheckBox" Content="Restart automatically after an unexpected crash"
                                      Foreground="{StaticResource TextBrush}" Margin="1,15,0,0" />
                            <TextBlock x:Name="SettingsFeedbackText" Foreground="{StaticResource SecondaryAccentBrush}"
                                       TextWrapping="Wrap" Margin="1,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Run Setup" Click="RunSetupButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" />
                            <Button Content="Reset Settings" Click="ResetSettingsButton_Click" Style="{StaticResource DangerButton}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="SettingsCancelButton_Click" Margin="0,0,9,0" />
                            <Button Content="Save Settings" Click="SettingsSaveButton_Click" Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="6" Panel.ZIndex="103" Background="#D0000000"
              Visibility="Collapsed">
            <Border Width="760" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource SecondaryAccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="28">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="8" Opacity="0.75" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="NAIRDWOOD LAUNCHER SETUP" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Complete the essentials once; every value can be changed later in Settings."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,20" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <Border Padding="14" Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="1  DATABASE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" />
                                        <TextBlock x:Name="SetupMariaDbStatusText" Text="Checking MariaDB..." Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="SetupMariaDbButton" Content="Start MariaDB"
                                            Click="SetupMariaDbButton_Click" Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="2  SERVER LAUNCHER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" Margin="1,18,0,5" />
                            <DockPanel>
                                <Button Content="Browse" DockPanel.Dock="Right" Click="SetupExecutableBrowseButton_Click" Margin="7,0,0,0" />
                                <TextBox x:Name="SetupExecutablePathBox" ToolTip="FXServer.exe or launch script" />
                            </DockPanel>

                            <TextBlock Text="3  SERVER CONFIG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" Margin="1,18,0,5" />
                            <DockPanel>
                                <Button Content="Browse" DockPanel.Dock="Right" Click="SetupConfigBrowseButton_Click" Margin="7,0,0,0" />
                                <TextBox x:Name="SetupConfigPathBox" ToolTip="Usually server.cfg" />
                            </DockPanel>

                            <TextBlock Text="4  REMOTE COMMANDS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryAccentBrush}" Margin="1,18,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="SetupRconPasswordBox" Padding="10,7" Background="#242424"
                                             Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1" />
                                <Button Grid.Column="1" Content="Generate" Click="GenerateRconButton_Click" Margin="7,0,0,0" />
                            </Grid>
                            <CheckBox x:Name="SetupSkipRconCheckBox" Content="Skip RCON — console commands will be disabled"
                                      Foreground="{StaticResource TextBrush}" Margin="1,10,0,0"
                                      Checked="SetupSkipRconCheckBox_Changed" Unchecked="SetupSkipRconCheckBox_Changed" />
                            <TextBlock x:Name="SetupFeedbackText" Foreground="#FFB4B9" TextWrapping="Wrap" Margin="1,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Button Content="Skip Setup" HorizontalAlignment="Left" Click="SetupSkipButton_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="SetupCancelButton_Click" Margin="0,0,9,0" />
                            <Button Content="Finish Setup" Click="SetupFinishButton_Click" Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ResetSettingsOverlay" Grid.RowSpan="6" Panel.ZIndex="104" Background="#D0000000"
              Visibility="Collapsed">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="26">
                <StackPanel>
                    <TextBlock Text="RESET LAUNCHER SETTINGS?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="This clears the saved executable, config, RCON details and preferences. Session logs are not deleted."
                               Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Click="ResetSettingsCancelButton_Click" Margin="0,0,9,0" />
                        <Button Content="Reset Settings" Click="ResetSettingsConfirmButton_Click" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModalOverlay" Grid.RowSpan="6" Panel.ZIndex="100" Background="#B8000000"
              Visibility="Collapsed">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="26">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="KILL SERVER PROCESS?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="This immediately terminates FXServer, txAdmin, and every process launched beneath them. The server will not have an opportunity to shut down cleanly." />
                    <Border Margin="0,16,0,0" Padding="11" CornerRadius="6" Background="#3A2022">
                        <TextBlock Text="Use this only when the normal Stop control cannot close the server."
                                   Foreground="#FFB4B9" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Click="KillCancelButton_Click" Margin="0,0,9,0" />
                        <Button x:Name="KillConfirmButton" Content="Kill Now" Click="KillConfirmButton_Click"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="MariaDbWarningOverlay" Grid.RowSpan="6" Panel.ZIndex="100" Background="#B8000000"
              Visibility="Collapsed">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource SecondaryAccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="26">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="MARIADB IS NOT RUNNING" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="MariaDbWarningDetailText" Margin="0,12,0,0" TextWrapping="Wrap"
                               LineHeight="20" Foreground="{StaticResource MutedTextBrush}" />
                    <Border Margin="0,16,0,0" Padding="11" CornerRadius="6" Background="#1C2F42">
                        <TextBlock Text="FXServer may fail to load resources or save player data without its database."
                                   Foreground="#AFCFE8" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Click="MariaDbWarningCancelButton_Click" Margin="0,0,9,0" />
                        <Button Content="Start Anyway" Click="MariaDbStartAnywayButton_Click"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="CloseModalOverlay" Grid.RowSpan="6" Panel.ZIndex="110" Background="#B8000000"
              Visibility="Collapsed">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#292929" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5" CornerRadius="12" Padding="26">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="STOP SERVER AND EXIT?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="FXServer is still running. Nairdwood Launcher will stop the server and its complete owned process tree before closing." />
                    <Border Margin="0,16,0,0" Padding="11" CornerRadius="6" Background="#3A2022">
                        <TextBlock Text="Closing the launcher will also close FXServer and txAdmin so they cannot be left running in the background."
                                   Foreground="#FFB4B9" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="CloseCancelButton" Content="Cancel" Click="CloseCancelButton_Click" Margin="0,0,9,0" />
                        <Button x:Name="CloseConfirmButton" Content="Stop Server &amp; Exit"
                                Click="CloseConfirmButton_Click" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
